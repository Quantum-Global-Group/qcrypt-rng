# Copy to `.env.local` as needed.
#
# Base port for `npm run dev` / `npm start` (find-port.js scans upward if busy).
# Default in find-port.js is 3980 — qcrypt-rng-specific; avoids clashing with other Next apps on 3000/3040/3180.
# QUANTUM_ORACLE_UI_PORT=3980

# Optional: backend API (auto-discovery tries 9878–9882 if unset)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:9878/api/v2
#
# Backend CORS: set ALLOWED_ORIGINS in the API .env to include this UI origin
# (e.g. http://localhost:3980). Default backend config includes 3180 and 3980 for dev.
